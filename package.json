{
  "name": "corvus-db-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "dev:web": "turbo run dev --filter=@corvus/app-web-client --filter=@corvus/app-web-server",
    "dev:desktop": "turbo run dev --filter=@corvus/app-desktop-renderer --filter=@corvus/app-desktop-main",
    "build": "turbo run build",
    "build:app": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:it": "turbo run test:integration",
    "test:e2e": "playwright test",
    "lint": "eslint . && depcruise packages apps",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "check:contract": "tsx tools/check-contract.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:contract && pnpm build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@corvus/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tsx": "^4.23.12",
    "turbo": "^2.4.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
