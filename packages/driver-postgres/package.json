{
  "name": "@corvus/driver-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*"
    }
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "test:integration": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@corvus/contract": "workspace:*",
    "@corvus/driver-core": "workspace:*",
    "@corvus/sql": "workspace:*",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "pg-types": "^4.1.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
