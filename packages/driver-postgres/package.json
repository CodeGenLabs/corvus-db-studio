{
  "name": "@corvus/driver-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*"
    }
  },
  "scripts": {
    "build": "tsc -b --noEmit",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@corvus/contract": "workspace:*",
    "@corvus/driver-core": "workspace:*",
    "@corvus/sql": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
