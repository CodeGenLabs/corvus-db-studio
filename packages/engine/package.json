{
  "name": "@corvus/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "import": "./src/session/index.ts"
    },
    "./introspect": {
      "types": "./src/introspect/index.ts",
      "import": "./src/introspect/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*"
    }
  },
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "test:integration": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@corvus/contract": "workspace:*",
    "@corvus/driver-core": "workspace:*",
    "@corvus/sql": "workspace:*",
    "@corvus/storage": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@corvus/driver-postgres": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
