    "@corvus/driver-core": "workspace:*",
    "@corvus/sql": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/better-sqlite3": "^9.6.0"
  }
}
