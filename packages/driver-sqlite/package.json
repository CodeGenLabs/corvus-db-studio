  },
  "dependencies": {
    "@corvus/contract": "workspace:*",
    "@corvus/driver-core": "workspace:*",
    "@corvus/sql": "workspace:*",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "typescript": "^5.7.2"
  }
}
