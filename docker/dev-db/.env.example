# ==============================================================================
# Corvus DB Studio — Biến môi trường Docker Compose (docker/dev-db/compose.yaml)
# ==============================================================================

# PostgreSQL
DEV_DB_POSTGRES_PORT=5432
DEV_DB_POSTGRES_DATABASE=corvus_dev
DEV_DB_POSTGRES_USER=corvus
DEV_DB_POSTGRES_PASSWORD=corvus_dev_pw

# MySQL
DEV_DB_MYSQL_PORT=3306
DEV_DB_MYSQL_DATABASE=corvus_dev
DEV_DB_MYSQL_USER=corvus
DEV_DB_MYSQL_PASSWORD=corvus_dev_pw
DEV_DB_MYSQL_ROOT_PASSWORD=corvus_dev_root_pw

# MariaDB
DEV_DB_MARIADB_PORT=3307
DEV_DB_MARIADB_DATABASE=corvus_dev
DEV_DB_MARIADB_USER=corvus
DEV_DB_MARIADB_PASSWORD=corvus_dev_pw
DEV_DB_MARIADB_ROOT_PASSWORD=corvus_dev_root_pw

# SQL Server (MSSQL) — Port 1434 (Tránh đè cổng 1433 của host)
DEV_DB_MSSQL_PORT=1434
DEV_DB_MSSQL_PASSWORD=Corvus_dev_pw1

# Oracle Database 23 Free
DEV_DB_ORACLE_PORT=1521
DEV_DB_ORACLE_DATABASE=FREEPDB1
DEV_DB_ORACLE_USER=CORVUS_DEV
DEV_DB_ORACLE_PASSWORD=corvus_dev_pw
DEV_DB_ORACLE_SYS_PASSWORD=corvus_dev_pw

# MongoDB
DEV_DB_MONGODB_PORT=27017
DEV_DB_MONGODB_DATABASE=corvus_dev
DEV_DB_MONGODB_USER=corvus
DEV_DB_MONGODB_PASSWORD=corvus_dev_pw

# Redis
DEV_DB_REDIS_PORT=6379
DEV_DB_REDIS_PASSWORD=corvus_dev_pw
